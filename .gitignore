# Only explicitly reviewed project material belongs in this public repository.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/NOTICE
!/THIRD_PARTY_NOTICES.md
!/README.md
!/CHANGELOG.md
!/BUILD_HISTORY.md
!/BUILD_HISTORY.json
!/version.json
!/src/
!/tools/
!/docs/

# Local workspace/reference material and generated output (never publish).
/sources/
/artifacts/
/AGENTS.md
/.build-version.lock
.vs/
.vscode/
.idea/
[Bb]in/
[Oo]bj/
packages/
__pycache__/
.venv/
*.user
*.suo
*.log
*.tmp
*.bak

# Restored runtimes, packages and model weights are not source assets.
*.dll
*.exe
*.pdb
*.nupkg
*.zip
*.7z
*.onnx
*.pth
*.pt
*.ckpt
*.safetensors
*.f32
/src/ZonerInspiredViewer/Assets/*.ps

# Machine-local settings, photo backups and credentials.
.env
.env.*
*.pfx
*.p12
*.pem
*.key
*.sqlite
*.sqlite-*
*.db
*.db-*
session.json
session-*.json
browser.json
sessions/
instances/
thumbs/
search-index/
backups/
viewer-backup*.json
.viewer-enhance-backups/
.viewer-rotation-backups/
.zen-batch-backups/
